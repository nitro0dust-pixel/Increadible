{
  "name": "ab-statistics",
  "description": "Known measurements in, known statistics out; and the variants that known users get. Variant A gets 10 + (i mod 7) and variant B 14 + (i mod 5) for i = 0..59, so mean(A) = 12.9, mean(B) = 16, s(A) = 2.0059, s(B) = 1.4261 and Cohen's d = -1.78, worked out by hand (the test of this scenario repeats the arithmetic from the values below). The p-value is checked as a bound only: the server turns t into an approximate z. The assignment golden (16 users in one experiment) is a regression record taken from the server itself, not worked out: a change in it means existing users would be given other variants. It adds 360 measurements to the server's A/B data, which is never compacted, so it runs only against a server the driver starts itself.",
  "scope": "own-server",
  "steps": [
    {
      "name": "create the experiment",
      "tool": "create_experiment",
      "writes": true,
      "arguments": {
        "id": "stats-${run_id}",
        "name": "known data",
        "hypothesis": "known data gives known statistics",
        "variants": [
          {
            "id": "A",
            "name": "a",
            "config": {}
          },
          {
            "id": "B",
            "name": "b",
            "config": {}
          }
        ],
        "metrics": [
          {
            "id": "quality",
            "name": "quality",
            "type": "continuous",
            "aggregation": "mean"
          }
        ]
      },
      "expect": {
        "json": {
          "status": "success",
          "experiment_id": "stats-${run_id}"
        }
      }
    },
    {
      "name": "record 60 measurements for A",
      "tool": "record_metric",
      "writes": true,
      "each": [10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13],
      "arguments": {
        "experiment_id": "stats-${run_id}",
        "variant_id": "A",
        "metrics": {
          "quality": "${each}"
        }
      },
      "expect": {
        "json": {
          "status": "recorded"
        }
      }
    },
    {
      "name": "results are incomplete at 60 of 100 samples",
      "tool": "get_experiment_results",
      "arguments": {
        "experiment_id": "stats-${run_id}"
      },
      "expect": {
        "json": {
          "status": "incomplete",
          "statistical_analysis.current_samples": 60,
          "statistical_analysis.message": "Need 40 more samples"
        }
      }
    },
    {
      "name": "no winner is recommended yet",
      "tool": "recommend_winner",
      "arguments": {
        "experiment_id": "stats-${run_id}"
      },
      "expect": {
        "json": {
          "recommendation": "Insufficient data for recommendation"
        }
      }
    },
    {
      "name": "record 60 measurements for B",
      "tool": "record_metric",
      "writes": true,
      "each": [14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18, 14, 15, 16, 17, 18],
      "arguments": {
        "experiment_id": "stats-${run_id}",
        "variant_id": "B",
        "metrics": {
          "quality": "${each}"
        }
      },
      "expect": {
        "json": {
          "status": "recorded"
        }
      }
    },
    {
      "name": "results: means, spreads, intervals, effect size and p-value of the known data",
      "tool": "get_experiment_results",
      "arguments": {
        "experiment_id": "stats-${run_id}"
      },
      "expect": {
        "json": {
          "status": "complete",
          "variant_results.A.metrics.quality.sample_size": 60,
          "variant_results.A.metrics.quality.mean": {
            "$near": [12.9, 0.0001]
          },
          "variant_results.A.metrics.quality.std_dev": {
            "$near": [2.0059, 0.0001]
          },
          "variant_results.A.metrics.quality.ci_95.0": {
            "$gte": 12.369,
            "$lte": 12.393
          },
          "variant_results.A.metrics.quality.ci_95.1": {
            "$gte": 13.407,
            "$lte": 13.431
          },
          "variant_results.B.metrics.quality.sample_size": 60,
          "variant_results.B.metrics.quality.mean": {
            "$near": [16, 0.0001]
          },
          "variant_results.B.metrics.quality.std_dev": {
            "$near": [1.4261, 0.0001]
          },
          "variant_results.B.metrics.quality.ci_95.0": {
            "$gte": 15.622,
            "$lte": 15.64
          },
          "variant_results.B.metrics.quality.ci_95.1": {
            "$gte": 16.36,
            "$lte": 16.378
          },
          "statistical_analysis.significance_level": 0.05,
          "statistical_analysis.p_values.quality": {
            "$lte": 0.000001
          },
          "statistical_analysis.effect_sizes.quality": {
            "$near": [-1.78, 0.005]
          },
          "winner": "B",
          "confidence": {
            "$gte": 0.95
          }
        }
      }
    },
    {
      "name": "the winner is B",
      "tool": "recommend_winner",
      "arguments": {
        "experiment_id": "stats-${run_id}"
      },
      "expect": {
        "json": {
          "recommendation": "B"
        }
      }
    },
    {
      "name": "create a second experiment",
      "tool": "create_experiment",
      "writes": true,
      "arguments": {
        "id": "same-${run_id}",
        "name": "known data",
        "hypothesis": "the same data in both variants shows no difference",
        "variants": [
          {
            "id": "A",
            "name": "a",
            "config": {}
          },
          {
            "id": "B",
            "name": "b",
            "config": {}
          }
        ],
        "metrics": [
          {
            "id": "quality",
            "name": "quality",
            "type": "continuous",
            "aggregation": "mean"
          }
        ]
      },
      "expect": {
        "json": {
          "status": "success",
          "experiment_id": "same-${run_id}"
        }
      }
    },
    {
      "name": "the same 60 measurements for A",
      "tool": "record_metric",
      "writes": true,
      "each": [10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13],
      "arguments": {
        "experiment_id": "same-${run_id}",
        "variant_id": "A",
        "metrics": {
          "quality": "${each}"
        }
      },
      "expect": {
        "json": {
          "status": "recorded"
        }
      }
    },
    {
      "name": "the same 60 measurements for B",
      "tool": "record_metric",
      "writes": true,
      "each": [10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13],
      "arguments": {
        "experiment_id": "same-${run_id}",
        "variant_id": "B",
        "metrics": {
          "quality": "${each}"
        }
      },
      "expect": {
        "json": {
          "status": "recorded"
        }
      }
    },
    {
      "name": "results: no difference, p = 1, no winner",
      "tool": "get_experiment_results",
      "arguments": {
        "experiment_id": "same-${run_id}"
      },
      "expect": {
        "json": {
          "status": "complete",
          "variant_results.A.metrics.quality.mean": {
            "$near": [12.9, 0.0001]
          },
          "variant_results.B.metrics.quality.mean": {
            "$near": [12.9, 0.0001]
          },
          "statistical_analysis.p_values.quality": {
            "$near": [1, 0.000001]
          },
          "statistical_analysis.effect_sizes.quality": {
            "$near": [0, 0.000001]
          },
          "confidence": 0,
          "winner": {
            "$exists": false
          }
        }
      }
    },
    {
      "name": "no clear winner",
      "tool": "recommend_winner",
      "arguments": {
        "experiment_id": "same-${run_id}"
      },
      "expect": {
        "json": {
          "recommendation": "No clear winner"
        }
      }
    },
    {
      "name": "a third experiment: nearly equal data",
      "tool": "create_experiment",
      "writes": true,
      "arguments": {
        "id": "nearly-${run_id}",
        "name": "known data",
        "hypothesis": "a difference of 1/60 is not significant",
        "variants": [
          {
            "id": "A",
            "name": "a",
            "config": {}
          },
          {
            "id": "B",
            "name": "b",
            "config": {}
          }
        ],
        "metrics": [
          {
            "id": "quality",
            "name": "quality",
            "type": "continuous",
            "aggregation": "mean"
          }
        ]
      },
      "expect": {
        "json": {
          "status": "success",
          "experiment_id": "nearly-${run_id}"
        }
      }
    },
    {
      "name": "nearly equal: 60 measurements for A",
      "tool": "record_metric",
      "writes": true,
      "each": [10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13],
      "arguments": {
        "experiment_id": "nearly-${run_id}",
        "variant_id": "A",
        "metrics": {
          "quality": "${each}"
        }
      },
      "expect": {
        "json": {
          "status": "recorded"
        }
      }
    },
    {
      "name": "nearly equal: the same 60 with the first raised by 1 for B",
      "tool": "record_metric",
      "writes": true,
      "each": [11, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13, 14, 15, 16, 10, 11, 12, 13],
      "arguments": {
        "experiment_id": "nearly-${run_id}",
        "variant_id": "B",
        "metrics": {
          "quality": "${each}"
        }
      },
      "expect": {
        "json": {
          "status": "recorded"
        }
      }
    },
    {
      "name": "results: a leader that is not significant is not a winner",
      "tool": "get_experiment_results",
      "arguments": {
        "experiment_id": "nearly-${run_id}"
      },
      "expect": {
        "json": {
          "status": "complete",
          "variant_results.A.metrics.quality.mean": {
            "$near": [12.9, 0.0001]
          },
          "variant_results.B.metrics.quality.mean": {
            "$near": [12.916667, 0.0001]
          },
          "statistical_analysis.p_values.quality": {
            "$gte": 0.9,
            "$lte": 1
          },
          "statistical_analysis.effect_sizes.quality": {
            "$near": [-0.0083, 0.01]
          },
          "confidence": {
            "$lte": 0.1
          },
          "winner": {
            "$exists": false
          }
        }
      }
    },
    {
      "name": "no clear winner for it either",
      "tool": "recommend_winner",
      "arguments": {
        "experiment_id": "nearly-${run_id}"
      },
      "expect": {
        "json": {
          "recommendation": "No clear winner"
        }
      }
    },
    {
      "name": "assignment: the experiment for the users",
      "tool": "create_experiment",
      "writes": true,
      "arguments": {
        "id": "assign-golden",
        "name": "known data",
        "hypothesis": "users keep their variant, version after version",
        "variants": [
          {
            "id": "A",
            "name": "a",
            "config": {}
          },
          {
            "id": "B",
            "name": "b",
            "config": {}
          }
        ],
        "metrics": [
          {
            "id": "quality",
            "name": "quality",
            "type": "continuous",
            "aggregation": "mean"
          }
        ]
      },
      "expect": {
        "json": {
          "status": "success",
          "experiment_id": "assign-golden"
        }
      }
    },
    {
      "name": "assignment: 16 users get the variants recorded for them, and the same one again when asked a second time",
      "tool": "assign_variant",
      "writes": true,
      "each": [
        {
          "user": "user-1",
          "variant": "B"
        },
        {
          "user": "user-2",
          "variant": "A"
        },
        {
          "user": "user-3",
          "variant": "A"
        },
        {
          "user": "user-4",
          "variant": "A"
        },
        {
          "user": "user-5",
          "variant": "B"
        },
        {
          "user": "user-6",
          "variant": "A"
        },
        {
          "user": "user-7",
          "variant": "A"
        },
        {
          "user": "user-8",
          "variant": "B"
        },
        {
          "user": "user-9",
          "variant": "B"
        },
        {
          "user": "user-10",
          "variant": "B"
        },
        {
          "user": "user-11",
          "variant": "B"
        },
        {
          "user": "user-12",
          "variant": "A"
        },
        {
          "user": "user-13",
          "variant": "B"
        },
        {
          "user": "user-14",
          "variant": "B"
        },
        {
          "user": "user-15",
          "variant": "A"
        },
        {
          "user": "user-16",
          "variant": "B"
        }
      ],
      "same_again": true,
      "arguments": {
        "experiment_id": "assign-golden",
        "user_id": "${each.user}"
      },
      "expect": {
        "json": {
          "variant_id": "${each.variant}",
          "experiment_id": "assign-golden"
        }
      }
    },
    {
      "name": "error: a variant that is not in the experiment",
      "tool": "record_metric",
      "arguments": {
        "experiment_id": "stats-${run_id}",
        "variant_id": "Z",
        "metrics": {
          "quality": 1
        }
      },
      "expect": {
        "tool_error": true,
        "contains": "is not part of experiment"
      }
    },
    {
      "name": "error: a metric the experiment does not have",
      "tool": "record_metric",
      "arguments": {
        "experiment_id": "stats-${run_id}",
        "variant_id": "A",
        "metrics": {
          "nope": 1
        }
      },
      "expect": {
        "tool_error": true,
        "contains": "Unknown metric"
      }
    },
    {
      "name": "error: a value that is not a number",
      "tool": "record_metric",
      "arguments": {
        "experiment_id": "stats-${run_id}",
        "variant_id": "A",
        "metrics": {
          "quality": "x"
        }
      },
      "expect": {
        "tool_error": true,
        "contains": "must be a finite number"
      }
    },
    {
      "name": "error: a number the experiment refuses (beyond the largest value it keeps)",
      "tool": "record_metric",
      "arguments": {
        "experiment_id": "stats-${run_id}",
        "variant_id": "A",
        "metrics": {
          "quality": 10000000000000000
        }
      },
      "expect": {
        "tool_error": true,
        "contains": "must be between"
      }
    },
    {
      "name": "error: an experiment that does not exist",
      "tool": "get_experiment_results",
      "arguments": {
        "experiment_id": "no-such-${run_id}"
      },
      "expect": {
        "tool_error": true,
        "contains": "Experiment not found"
      }
    },
    {
      "name": "error: an id that is already taken",
      "tool": "create_experiment",
      "arguments": {
        "id": "stats-${run_id}",
        "name": "known data",
        "hypothesis": "again",
        "variants": [
          {
            "id": "A",
            "name": "a",
            "config": {}
          },
          {
            "id": "B",
            "name": "b",
            "config": {}
          }
        ],
        "metrics": [
          {
            "id": "quality",
            "name": "quality",
            "type": "continuous",
            "aggregation": "mean"
          }
        ]
      },
      "expect": {
        "tool_error": true,
        "contains": "already exists"
      }
    },
    {
      "name": "the refused calls changed nothing: still 60 and 60 samples",
      "tool": "get_experiment_results",
      "arguments": {
        "experiment_id": "stats-${run_id}"
      },
      "expect": {
        "json": {
          "variant_results.A.metrics.quality.sample_size": 60,
          "variant_results.B.metrics.quality.sample_size": 60
        }
      }
    }
  ]
}
