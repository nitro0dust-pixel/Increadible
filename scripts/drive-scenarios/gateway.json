{
  "name": "gateway",
  "description": "The API gateway on its sample data: discovery (all nine ids in the registry's order, so adding an API to the catalog means updating the counts and ids here), one call to each of the nine APIs, the cache (also with params), an empty endpoint and null params, every error the tools name, aggregation (partial failure, order, the limit of 100 from both sides), and the counters, which are compared API by API with a count of the calls this scenario itself makes by the rule in docs/USING-THE-GATEWAY.md (total = successful + failed + cache hits). It asserts that every answer is sample data (live calls off), which is also why it never runs against a server it did not start: with live APIs on, the same calls would reach real providers.",
  "scope": "own-server",
  "steps": [
    {
      "name": "discover: all nine APIs, in the registry's order",
      "tool": "discover_apis",
      "expect": {
        "json": {
          "length": 9,
          "0.id": "openweathermap",
          "1.id": "weatherapi",
          "2.id": "coingecko",
          "3.id": "finnhub",
          "4.id": "newsapi",
          "5.id": "hackernews",
          "6.id": "wikipedia",
          "7.id": "wikidata",
          "8.id": "thesportsdb",
          "0.auth": "api_key",
          "2.auth": "none"
        }
      }
    },
    {
      "name": "discover: a search finds the APIs by name or category",
      "tool": "discover_apis",
      "arguments": {
        "query": "weather"
      },
      "expect": {
        "json": {
          "length": 2,
          "0.id": "openweathermap",
          "1.id": "weatherapi"
        }
      }
    },
    {
      "name": "discover: the search ignores case",
      "tool": "discover_apis",
      "arguments": {
        "query": "NEWS"
      },
      "expect": {
        "json": {
          "length": 2,
          "0.id": "newsapi",
          "1.id": "hackernews"
        }
      }
    },
    {
      "name": "discover: a category",
      "tool": "discover_apis",
      "arguments": {
        "query": "finance"
      },
      "expect": {
        "json": {
          "length": 2,
          "0.id": "coingecko",
          "1.id": "finnhub"
        }
      }
    },
    {
      "name": "discover: nothing matches",
      "tool": "discover_apis",
      "arguments": {
        "query": "zzz-no-such-api"
      },
      "expect": {
        "json": {
          "length": 0
        }
      }
    },
    {
      "name": "discover: a query that is not text",
      "tool": "discover_apis",
      "arguments": {
        "query": 5
      },
      "expect": {
        "tool_error": true,
        "contains": "query must be a string"
      }
    },
    {
      "name": "call every API once: sample data, from the API, not from the cache",
      "tool": "call_api",
      "each": [
        "openweathermap",
        "weatherapi",
        "coingecko",
        "finnhub",
        "newsapi",
        "hackernews",
        "wikipedia",
        "wikidata",
        "thesportsdb"
      ],
      "arguments": {
        "api_id": "${each}",
        "endpoint": "/driver-${run_id}"
      },
      "expect": {
        "json": {
          "source": "mock",
          "cached": false,
          "timestamp": {
            "$type": "string"
          },
          "data": {
            "$exists": true
          }
        }
      }
    },
    {
      "name": "the same call again is answered from the cache",
      "tool": "call_api",
      "arguments": {
        "api_id": "coingecko",
        "endpoint": "/driver-${run_id}"
      },
      "expect": {
        "json": {
          "source": "mock",
          "cached": true
        }
      }
    },
    {
      "name": "a different endpoint of the same API is not",
      "tool": "call_api",
      "arguments": {
        "api_id": "coingecko",
        "endpoint": "/other-${run_id}"
      },
      "expect": {
        "json": {
          "source": "mock",
          "cached": false,
          "data.bitcoin.usd": 43250.5
        }
      }
    },
    {
      "name": "sample data: the weather API",
      "tool": "call_api",
      "arguments": {
        "api_id": "openweathermap",
        "endpoint": "/weather-${run_id}"
      },
      "expect": {
        "json": {
          "data.main.humidity": 65,
          "data.weather.0.main": "Partly Cloudy"
        }
      }
    },
    {
      "name": "sample data: the news API",
      "tool": "call_api",
      "arguments": {
        "api_id": "newsapi",
        "endpoint": "/news-${run_id}"
      },
      "expect": {
        "json": {
          "data.totalResults": 1,
          "data.articles.0.title": {
            "$type": "string"
          }
        }
      }
    },
    {
      "name": "params make a different call: {id: 1}",
      "tool": "call_api",
      "arguments": {
        "api_id": "hackernews",
        "endpoint": "/item-${run_id}",
        "params": {
          "id": 1
        }
      },
      "expect": {
        "json": {
          "cached": false,
          "data.data.id": 1
        }
      }
    },
    {
      "name": "params make a different call: {id: 2} is not answered with the first one's data",
      "tool": "call_api",
      "arguments": {
        "api_id": "hackernews",
        "endpoint": "/item-${run_id}",
        "params": {
          "id": 2
        }
      },
      "expect": {
        "json": {
          "cached": false,
          "data.data.id": 2
        }
      }
    },
    {
      "name": "the same params again are answered from the cache",
      "tool": "call_api",
      "arguments": {
        "api_id": "hackernews",
        "endpoint": "/item-${run_id}",
        "params": {
          "id": 1
        }
      },
      "expect": {
        "json": {
          "cached": true,
          "data.data.id": 1
        }
      }
    },
    {
      "name": "an empty endpoint is allowed (the API's root)",
      "tool": "call_api",
      "arguments": {
        "api_id": "wikipedia",
        "endpoint": ""
      },
      "expect": {
        "json": {
          "source": "mock"
        }
      }
    },
    {
      "name": "params that are null are allowed",
      "tool": "call_api",
      "arguments": {
        "api_id": "wikidata",
        "endpoint": "/null-${run_id}",
        "params": null
      },
      "expect": {
        "json": {
          "source": "mock"
        }
      }
    },
    {
      "name": "error: an API that does not exist",
      "tool": "call_api",
      "arguments": {
        "api_id": "no-such-api",
        "endpoint": "/x"
      },
      "expect": {
        "tool_error": true,
        "contains": "API not found: no-such-api"
      }
    },
    {
      "name": "error: the id is case sensitive",
      "tool": "call_api",
      "arguments": {
        "api_id": "CoinGecko",
        "endpoint": "/x"
      },
      "expect": {
        "tool_error": true,
        "contains": "API not found: CoinGecko"
      }
    },
    {
      "name": "error: no api_id",
      "tool": "call_api",
      "arguments": {
        "endpoint": "/x"
      },
      "expect": {
        "tool_error": true,
        "contains": "api_id must be a string"
      }
    },
    {
      "name": "error: an api_id that is a number",
      "tool": "call_api",
      "arguments": {
        "api_id": 5,
        "endpoint": "/x"
      },
      "expect": {
        "tool_error": true,
        "contains": "api_id must be a string"
      }
    },
    {
      "name": "error: no endpoint",
      "tool": "call_api",
      "arguments": {
        "api_id": "hackernews"
      },
      "expect": {
        "tool_error": true,
        "contains": "endpoint must be a string"
      }
    },
    {
      "name": "error: an endpoint that is a number",
      "tool": "call_api",
      "arguments": {
        "api_id": "hackernews",
        "endpoint": 5
      },
      "expect": {
        "tool_error": true,
        "contains": "endpoint must be a string"
      }
    },
    {
      "name": "error: params that are text",
      "tool": "call_api",
      "arguments": {
        "api_id": "hackernews",
        "endpoint": "/x",
        "params": "a=1"
      },
      "expect": {
        "tool_error": true,
        "contains": "params must be an object"
      }
    },
    {
      "name": "aggregate: two calls, two answers",
      "tool": "aggregate_apis",
      "arguments": {
        "apis": [
          {
            "id": "hackernews",
            "endpoint": "/agg-a-${run_id}"
          },
          {
            "id": "wikipedia",
            "endpoint": "/agg-b-${run_id}"
          }
        ]
      },
      "expect": {
        "json": {
          "count": 2,
          "data.0.source": "mock",
          "data.1.source": "mock"
        }
      }
    },
    {
      "name": "aggregate: an empty list is an empty answer",
      "tool": "aggregate_apis",
      "arguments": {
        "apis": []
      },
      "expect": {
        "json": {
          "count": 0,
          "data.length": 0
        }
      }
    },
    {
      "name": "aggregate: one call fails, the others keep their answers, in the order asked, and the reply is not an error",
      "tool": "aggregate_apis",
      "arguments": {
        "apis": [
          {
            "id": "coingecko",
            "endpoint": "/p1-${run_id}"
          },
          {
            "id": "no-such-api",
            "endpoint": "/x"
          },
          {
            "id": "openweathermap",
            "endpoint": "/p2-${run_id}"
          }
        ]
      },
      "expect": {
        "json": {
          "count": 3,
          "failed": 1,
          "data.0.data.bitcoin.usd": 43250.5,
          "data.1.error": "API not found: no-such-api",
          "data.2.data.main.humidity": 65
        }
      }
    },
    {
      "name": "aggregate: every call failed is an error that says so",
      "tool": "aggregate_apis",
      "arguments": {
        "apis": [
          {
            "id": "no-such-api",
            "endpoint": "/x"
          }
        ]
      },
      "expect": {
        "tool_error": true,
        "contains": "all 1 calls failed"
      }
    },
    {
      "name": "aggregate: a list that is not a list",
      "tool": "aggregate_apis",
      "arguments": {
        "apis": "hackernews"
      },
      "expect": {
        "tool_error": true,
        "contains": "apis must be an array"
      }
    },
    {
      "name": "aggregate: an entry that is not an object",
      "tool": "aggregate_apis",
      "arguments": {
        "apis": [
          "hackernews"
        ]
      },
      "expect": {
        "tool_error": true,
        "contains": "apis[0] must be an object"
      }
    },
    {
      "name": "aggregate: an entry without an id",
      "tool": "aggregate_apis",
      "arguments": {
        "apis": [
          {
            "endpoint": "/x"
          }
        ]
      },
      "expect": {
        "tool_error": true,
        "contains": "apis[0].id must be a string"
      }
    },
    {
      "name": "aggregate: an entry without an endpoint, named by its place",
      "tool": "aggregate_apis",
      "arguments": {
        "apis": [
          {
            "id": "hackernews",
            "endpoint": "/x"
          },
          {
            "id": "wikipedia"
          }
        ]
      },
      "expect": {
        "tool_error": true,
        "contains": "apis[1].endpoint must be a string"
      }
    },
