{
  "name": "increadible",
  "version": "1.0.6",
  "description": "MCP server bundling routing rules, A/B testing and an API gateway, alongside vendored cost/context tooling for Claude Desktop",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "node scripts/clean.js && tsc -p tsconfig.build.json",
    "test": "jest",
    "test:e2e": "jest tests/e2e-integration.test.ts",
    "test:watch": "jest --watch",
    "lint": "eslint src features/07-routing-plugins/src features/08-ab-testing/src features/09-api-gateway/src tests",
    "type-check": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "mcpb": "node scripts/mcpb.js build",
    "verify": "bash scripts/verify.sh",
    "smoke": "bash scripts/smoke.sh",
    "loadtest": "node scripts/loadtest.js",
    "capacity": "node scripts/capacity.js",
    "drive:stdio": "node scripts/drive-stdio.js",
    "drive:http": "node scripts/drive-http.js",
    "drive:probe": "node scripts/drive-probe.js",
    "drive:bundle": "node scripts/drive-bundle.js",
    "drive:all": "node scripts/drive-all.js",
    "drive:live": "node scripts/drive-live.js",
    "probe:remote": "node scripts/probe-remote.js"
  },
  "keywords": [
    "claude",
    "ai",
    "cost-optimization",
    "mcp-server",
    "routing",
    "a-b-testing",
    "api-gateway"
  ],
  "author": "Increadible Team",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22"
  }
}
