{
  "name": "increadible",
  "version": "1.0.0",
  "description": "MCP server bundling routing rules, A/B testing and an API gateway, alongside vendored cost/context tooling for Claude Desktop",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "node scripts/clean.js && tsc -p tsconfig.build.json",
    "test": "jest",
    "test:e2e": "jest tests/e2e-integration.test.ts",
    "test:watch": "jest --watch",
    "lint": "eslint --ext .ts src features/07-routing-plugins/src features/08-ab-testing/src features/09-api-gateway/src tests",
    "type-check": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "verify": "bash scripts/verify.sh",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [
    "claude",
    "ai",
    "cost-optimization",
    "mcp-server",
    "routing",
    "a-b-testing",
    "api-gateway"
  ],
  "author": "Increadible Team",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
